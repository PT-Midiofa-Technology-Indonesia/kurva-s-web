{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "enabled": true
    }
  },
  "plugin": [
		"superpowers@git+https://github.com/obra/superpowers.git",
    ".opencode/plugins/graphify.js"
	],
  "model": "9router-local/code-main",
  "mode": {
    "plan": {
      "model": "9router-local/code-architect"
    },
    "build": {
      "model": "9router-local/code-main"
    },
    "check": {
      "model": "9router-local/code-fast"
    }
  }
}
